rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is an admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true;
    }

    // Products: anyone can read active products, only admins can write/read all
    match /products/{productId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Categories: anyone can read active, admins can write
    match /categories/{categoryId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if isAdmin();
    }

    // Orders: Users can read/write their own, admins can read/write all
    match /orders/{orderId} {
      allow read, create: if true; // In a real app, only authenticated users or guests with a session token
      allow update, delete: if isAdmin();
    }

    // Admins: only admins can read admin list
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid || isAdmin();
      allow write: if false; // Only created manually or via secure backend
    }
  }
}
